{
  "incremental": false,
  "useTabs": false,
  "indentWidth": 4,
  "lineWidth": 140,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "prefer",
    "quoteStyle": "alwaysDouble",
    "arrowFunction.useParentheses": "force",
    "importDeclaration.forceSingleLine": false,
    "importDeclaration.sortNamedImports": "maintain",
    "importDeclaration.spaceSurroundingNamedImports": false,
    "exportDeclaration.spaceSurroundingNamedExports": false,
    "module.sortImportDeclarations": "maintain",
    "spaceSurroundingProperties": false,
    "spaceAround": false
  },
  "yaml": {
    "indentWidth": 2,
    "lineBreak": "lf",
    "quotes": "preferSingle",
    "trailingComma": true,
    "formatComments": false,
    "indentBlockSequenceInMap": true,
    "braceSpacing": true,
    "bracketSpacing": true,
    "dashSpacing": "oneSpace",
    "preferSingleLine": true,
    "trimTrailingWhitespaces": true,
    "trimTrailingZero": false,
    "proseWrap": "preserve",
    "ignoreCommentDirective": "pretty-yaml-ignore"
  },
  "json": {
    "indentWidth": 2,
    "trailingCommas": "never"
  },
  "includes": [
    "**/*.{ts,js,cjs,mjs,json,yaml,yml}"
  ],
  "excludes": [
    "/.git",
    "/node_modules",
    "/*-lock.{json,yaml,yml}",
    "/app",
    "/app-dev",
    "/dist",
    "/output"
  ],
  "plugins": [
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/typescript@0.96.1",
    "npm:dprint-plugin-yaml@0.6.0"
  ]
}
